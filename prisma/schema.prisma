generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  key         String   @id
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([updatedById])
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String             @default("USER")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  phone             String?
  accounts          Account[]
  adminCreationOtps AdminCreationOtp[]
  companiesCreated  Company[]          @relation("CompanyCreatedBy")
  expenses          Expense[]          @relation("ExpenseCreatedBy")
  ledgerEntries     LedgerEntry[]
  parties           Party[]
  payments          Payment[]
  products          Product[]
  reports           Report[]
  sessions          Session[]
  updatedSettings   Setting[]          @relation("SettingUpdatedBy")
  transactions      Transaction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdminCreationOtp {
  id             String    @id @default(cuid())
  superAdminId   String
  contact        String    @unique
  deliveryMethod String    @default("EMAIL")
  otpHash        String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  resendCooldown DateTime  @default(now())
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  superAdmin     User      @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([contact])
}

model Party {
  id                        Int               @id @default(autoincrement())
  name                      String
  phone                     String            @unique
  email                     String?
  address                   String?
  partyType                 String            @default("BOTH")
  taxNumber                 String?
  creditLimit               Decimal?
  openingBalance            Decimal           @default(0)
  imageUrl                  String?
  mediaName                 String?
  farmName                  String?
  isActive                  Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  createdById               String?
  openingBalanceType        String            @default("CUSTOMER_DUE")
  openingBalanceDescription String?
  dueAdjustments            DueAdjustment[]
  ledgerEntries             LedgerEntry[]
  createdBy                 User?             @relation(fields: [createdById], references: [id])
  payments                  Payment[]
  smsNotifications          SmsNotification[]
  transactions              Transaction[]

  @@index([name])
  @@index([isActive, partyType, name])
  @@index([openingBalanceType])
}

model Company {
  id                        Int               @id @default(autoincrement())
  name                      String            @unique
  contactPerson             String?
  phone                     String?
  email                     String?
  address                   String?
  companyType               String            @default("FEED")
  isActive                  Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  createdById               String?
  openingBalance            Decimal           @default(0)
  openingBalanceDescription String?
  createdBy                 User?             @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  dueAdjustments            DueAdjustment[]
  ledgerEntries             LedgerEntry[]     @relation("CompanyLedgerEntries")
  payments                  Payment[]         @relation("CompanyPayments")
  products                  Product[]
  smsNotifications          SmsNotification[]
  transactions              Transaction[]     @relation("CompanyTransactions")

  @@index([name])
  @@index([isActive, companyType, name])
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
  @@index([isActive, name])
}

model Product {
  id                   Int               @id @default(autoincrement())
  code                 String            @unique
  name                 String
  productType          String
  unit                 String
  categoryId           Int?
  defaultPurchasePrice Decimal?
  defaultSellingPrice  Decimal?
  barcode              String?
  imageUrl             String?
  lowStockThreshold    Decimal?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdById          String?
  companyId            Int?
  deletedAt            DateTime?
  isArchived           Boolean           @default(false)
  category             ProductCategory?  @relation(fields: [categoryId], references: [id])
  company              Company?          @relation(fields: [companyId], references: [id])
  createdBy            User?             @relation(fields: [createdById], references: [id])
  stockBalance         StockBalance?
  stockMovements       StockMovement[]
  transactionItems     TransactionItem[]

  @@index([productType, name])
  @@index([isActive, productType, name])
  @@index([categoryId, isActive])
  @@index([companyId])
}

model StockBalance {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  quantityOnHand   Decimal  @default(0)
  reservedQuantity Decimal  @default(0)
  averageCost      Decimal?
  lastUpdatedAt    DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  transactionId Int?
  movementType  String
  quantity      Decimal
  unitCost      Decimal?
  notes         String?
  createdAt     DateTime     @default(now())
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([productId, createdAt])
}

model Transaction {
  id               Int                 @id @default(autoincrement())
  transactionType  String
  partyId          Int?
  transactionDate  DateTime            @default(now())
  invoiceNumber    String              @unique
  referenceNumber  String?
  status           String              @default("COMPLETED")
  subtotal         Decimal
  discount         Decimal             @default(0)
  tax              Decimal             @default(0)
  totalAmount      Decimal
  paidAmount       Decimal             @default(0)
  dueAmount        Decimal             @default(0)
  dueDate          DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdById      String?
  companyId        Int?
  dueAdjustments   DueAdjustment[]
  ledgerEntries    LedgerEntry[]
  payments         PaymentAllocation[]
  smsNotifications SmsNotification?
  stockMovements   StockMovement[]
  company          Company?            @relation("CompanyTransactions", fields: [companyId], references: [id])
  createdBy        User?               @relation(fields: [createdById], references: [id])
  party            Party?              @relation(fields: [partyId], references: [id])
  transactionItems TransactionItem[]

  @@index([partyId, transactionDate])
  @@index([companyId, transactionDate])
  @@index([transactionType, transactionDate])
  @@index([transactionType, status])
}

model TransactionItem {
  id              Int         @id @default(autoincrement())
  transactionId   Int
  productId       Int
  quantity        Decimal
  unitPrice       Decimal
  lineTotal       Decimal
  taxAmount       Decimal     @default(0)
  description     String?
  chickenQuantity Decimal?
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([productId])
}

model SmsNotification {
  id                Int                   @id @default(autoincrement())
  partyId           Int?
  transactionId     Int?                  @unique
  phoneNumber       String?
  saleType          String
  message           String
  status            SmsNotificationStatus @default(QUEUED)
  provider          String                @default("mock")
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  companyId         Int?
  company           Company?              @relation(fields: [companyId], references: [id])
  party             Party?                @relation(fields: [partyId], references: [id])
  transaction       Transaction?          @relation(fields: [transactionId], references: [id])

  @@index([partyId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id              Int                 @id @default(autoincrement())
  partyId         Int?
  paymentDate     DateTime            @default(now())
  paymentMethod   String
  amount          Decimal
  referenceNumber String?
  status          String              @default("COMPLETED")
  notes           String?
  createdAt       DateTime            @default(now())
  createdById     String?
  companyId       Int?
  ledgerEntries   LedgerEntry[]
  company         Company?            @relation("CompanyPayments", fields: [companyId], references: [id])
  createdBy       User?               @relation(fields: [createdById], references: [id])
  party           Party?              @relation(fields: [partyId], references: [id])
  allocations     PaymentAllocation[]

  @@index([partyId, paymentDate])
  @@index([companyId, paymentDate])
  @@index([paymentDate])
}

model PaymentAllocation {
  id             Int         @id @default(autoincrement())
  paymentId      Int
  transactionId  Int
  amount         Decimal
  allocationDate DateTime    @default(now())
  payment        Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([paymentId, transactionId])
}

model LedgerEntry {
  id              Int          @id @default(autoincrement())
  entryDate       DateTime     @default(now())
  partyId         Int?
  transactionId   Int?
  paymentId       Int?
  entryType       String
  amount          Decimal
  runningBalance  Decimal
  description     String?
  referenceNumber String?
  createdById     String?
  companyId       Int?
  company         Company?     @relation("CompanyLedgerEntries", fields: [companyId], references: [id])
  createdBy       User?        @relation(fields: [createdById], references: [id])
  party           Party?       @relation(fields: [partyId], references: [id])
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  @@index([partyId, entryDate])
  @@index([companyId, entryDate])
  @@index([partyId, entryDate, id])
  @@index([companyId, entryDate, id])
}

model DueAdjustment {
  id             Int         @id @default(autoincrement())
  transactionId  Int
  partyId        Int?
  adjustmentType String
  amount         Decimal
  reason         String?
  isAuto         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  companyId      Int?
  company        Company?    @relation(fields: [companyId], references: [id])
  party          Party?      @relation(fields: [partyId], references: [id])
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([companyId])
}

model Report {
  id          Int      @id @default(autoincrement())
  reportType  String
  title       String
  generatedAt DateTime @default(now())
  filters     String?
  summary     String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([reportType, generatedAt])
}

model Expense {
  id          Int       @id @default(autoincrement())
  amount      Decimal
  description String?
  expenseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  createdBy   User?     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([expenseDate])
}

enum SmsNotificationStatus {
  QUEUED
  PENDING
  SENT
  FAILED
  SKIPPED
}
