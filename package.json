{
  "name": "poultry-farm-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "postinstall": "prisma generate",
    "clean:next": "node scripts/clear-next-cache.mjs",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "prisma:validate:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js validate --schema=prisma/schema.prisma",
    "prisma:generate:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js generate --schema=prisma/schema.prisma",
    "prisma:push:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push --schema=prisma/schema.prisma",
    "prisma:push:local:preview": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push --schema=prisma/schema.prisma --print",
    "prisma:migrate:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate dev --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.20",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.0",
    "pg": "^8.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.2.0",
    "react-hot-toast": "2.6.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "overrides": {
    "@unrs/resolver-binding-wasm32-wasi": {
      "@napi-rs/wasm-runtime": "1.1.6"
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "playwright": "^1.62.1",
    "postcss": "^8.5.20",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
